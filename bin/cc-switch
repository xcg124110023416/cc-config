#!/usr/bin/env bash
set -u

SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
REPO_DIR=$(cd -- "$(dirname -- "$SELF")/.." && pwd -P)
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
WRAPPER_BACKUP_DIR="$CLAUDE_DIR/backups/cc-config-wrapper"

rotate_wrapper_backups() {
  local backup_dir=$1
  local keep=${2:-20}
  local -a backups=()
  local index

  [[ -d $backup_dir ]] || return 0
  mapfile -d '' -t backups < <(
    find "$backup_dir" -maxdepth 1 -type f -name 'settings.json.*.bak' \
      -printf '%T@\t%p\0' | sort -z -nr
  )
  for ((index = keep; index < ${#backups[@]}; index++)); do
    rm -f -- "${backups[index]#*$'\t'}"
  done
}

find_real_cc_switch() {
  local old_ifs=$IFS
  local directory candidate resolved
  IFS=:
  for directory in ${PATH:-}; do
    [[ -n $directory ]] || directory=.
    candidate="$directory/cc-switch"
    [[ -x $candidate ]] || continue
    resolved=$(readlink -f -- "$candidate" 2>/dev/null || true)
    if [[ -n $resolved && $resolved != "$SELF" ]]; then
      IFS=$old_ifs
      printf '%s\n' "$resolved"
      return 0
    fi
  done
  IFS=$old_ifs
  return 1
}

REAL_CC_SWITCH=$(find_real_cc_switch) || {
  printf 'ERROR: real cc-switch not found after excluding wrapper: %s\n' "$SELF" >&2
  exit 127
}

# Classify the invocation:
#   passthrough      -> ordinary/read-only subcommand; forward unchanged
#   explicit_switch  -> `use` / `provider switch` for Claude
#   interactive      -> bare `cc-switch` or `cc-switch interactive` (TUI)
classify_mode() {
  local app=claude
  local -a positional=()
  local -a flag_only=()
  local index=1 argument help_or_version=0

  while ((index <= $#)); do
    argument=${!index}
    case "$argument" in
      -a|--app)
        ((index++))
        ((index <= $#)) || return 1
        app=${!index}
        ;;
      --app=*) app=${argument#--app=} ;;
      -v|--verbose) ;;
      -h|--help|-V|--version) help_or_version=1 ;;
      --) ;;
      *) positional+=("$argument") ;;
    esac
    ((index++))
  done
  # shellcheck disable=SC2034
  flag_only=()

  if ((${#positional[@]})); then
    case "${positional[0]}" in
      use)
        if [[ $app == claude ]]; then
          printf 'explicit_switch\n'
        else
          printf 'passthrough\n'
        fi
        return 0
        ;;
      provider)
        if [[ ${positional[1]:-} == switch && $app == claude ]]; then
          printf 'explicit_switch\n'
        else
          printf 'passthrough\n'
        fi
        return 0
        ;;
      interactive) printf 'interactive\n'; return 0 ;;
      help) printf 'passthrough\n'; return 0 ;;
      *) printf 'passthrough\n'; return 0 ;;
    esac
  fi

  if ((help_or_version == 1)); then
    printf 'passthrough\n'
    return 0
  fi
  printf 'interactive\n'
}

restore_portable() {
  local problems=0

  if ! command -v python3 >/dev/null 2>&1; then
    printf 'ERROR: python3 unavailable; portable Claude settings were not restored.\n' >&2
    return 1
  fi

  if ! python3 "$REPO_DIR/scripts/merge-settings.py" merge \
    --portable "$REPO_DIR/settings.portable.json" \
    --target "$CLAUDE_DIR/settings.json" \
    --backup-dir "$WRAPPER_BACKUP_DIR"; then
    printf 'ERROR: portable Claude settings could not be restored.\n' >&2
    problems=1
  fi

  if command -v serena-hooks >/dev/null 2>&1; then
    if ! python3 "$REPO_DIR/scripts/merge-settings.py" merge-hooks \
      --hooks "$REPO_DIR/hooks.portable.json" \
      --target "$CLAUDE_DIR/settings.json" \
      --backup-dir "$WRAPPER_BACKUP_DIR"; then
      printf 'WARNING: portable serena hooks could not be restored.\n' >&2
    fi
  else
    printf 'WARNING: serena-hooks is missing; portable serena hooks were not restored.\n' >&2
  fi

  rotate_wrapper_backups "$WRAPPER_BACKUP_DIR" 20 || {
    printf 'WARNING: wrapper backup rotation failed; backups retained.\n' >&2
  }

  return "$problems"
}

mode=$(classify_mode "$@")

case "$mode" in
  passthrough)
    exec "$REAL_CC_SWITCH" "$@"
    ;;
  explicit_switch|interactive)
    # Snapshot pre-switch settings so local (non-portable) hooks — e.g. peon-ping —
    # survive provider switches that rewrite settings.json. Portable fields and serena
    # hooks are restored by restore_portable; anything else that existed before the
    # switch is re-merged from this snapshot.
    snapshot=$(mktemp "${TMPDIR:-/tmp}/cc-config-preshift.XXXXXX.json") || snapshot=""
    have_snapshot=0
    if [[ -n $snapshot && -f $CLAUDE_DIR/settings.json ]]; then
      cp -- "$CLAUDE_DIR/settings.json" "$snapshot" && have_snapshot=1
    fi

    "$REAL_CC_SWITCH" "$@"
    status=$?
    if ((status != 0)); then
      [[ -n $snapshot ]] && rm -f -- "$snapshot"
      exit "$status"
    fi
    restore_portable
    code=$?
    if ((have_snapshot == 1)) && command -v python3 >/dev/null 2>&1; then
      if ! python3 "$REPO_DIR/scripts/merge-settings.py" merge-hooks \
        --hooks "$snapshot" \
        --target "$CLAUDE_DIR/settings.json" \
        --backup-dir "$WRAPPER_BACKUP_DIR"; then
        printf 'WARNING: local hooks could not be restored after provider change.\n' >&2
        code=1
      fi
    fi
    [[ -n $snapshot ]] && rm -f -- "$snapshot"
    if ((code == 0)); then
      printf 'Portable Claude settings and hooks restored after CC-Switch Provider change.\n'
    fi
    exit "$code"
    ;;
esac
