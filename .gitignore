# Deny local state and secrets even if accidentally copied here.
.claude.json
settings.json
config.json
.env
.env.*
**/.env
**/.env.*
**/*token*
**/*secret*
**/*credential*
**/*oauth*
**/*session*
**/*history*
**/*cache*
**/*debug*
**/*telemetry*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Claude runtime state.
projects/
sessions/
history.jsonl
cache/
paste-cache/
image-cache/
file-history/
shell-snapshots/
session-env/
backups/
tasks/
plans/
teams/
telemetry/
plugins/cache/
plugins/marketplaces/
.last-*
*.tmp
*.bak

# Local updater safety copies and tooling output.
.local-backups/
.serena/
.codegraph/
__pycache__/
*.pyc
.DS_Store
